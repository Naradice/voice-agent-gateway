{
  "name": "voice-agent-gateway",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "p0a": "node --experimental-strip-types packages/phase0a-codex-probe/src/probe.ts",
    "p0a:write": "node --experimental-strip-types packages/phase0a-codex-probe/src/probe-write.ts --allow-write",
    "p0a:hold": "node --experimental-strip-types packages/phase0a-codex-probe/src/probe-hold.ts --allow-write",
    "p0a:approval": "node --experimental-strip-types packages/phase0a-codex-probe/src/probe-approval.ts --allow-write",
    "p0b": "node --experimental-strip-types packages/phase0b-router-eval/src/run.ts",
    "test": "node --experimental-strip-types --no-warnings --test packages/gateway/test/*.test.ts",
    "smoke:local": "node --experimental-strip-types --no-warnings packages/gateway/scripts/smoke-local.ts",
    "diagnose:thinking": "node --experimental-strip-types --no-warnings packages/gateway/scripts/diagnose-thinking.ts",
    "llm": "node --experimental-strip-types --no-warnings packages/gateway/scripts/llm.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
