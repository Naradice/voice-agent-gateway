# 実際の .env は `npm run gateway:init` で作る(トークンを自動生成する)。このファイルは書式の見本。
# .env には秘密(トークン)が入る。コミットしない・チャットに貼らない。
VAG_DEVICES='[{"deviceId":"pixel","token":"24文字以上のランダム文字列"}]'
VAG_HOST=100.x.x.x
VAG_PORT=8787

# ローカルLLM(GPU を使わない構成。モデルは `npm run ollama:model -- qwen3:4b-instruct` で作る)
LOCAL_MODEL=qwen3-4b-instruct-cpu
LOCAL_DEVICE=cpu
LOCAL_HISTORY_CHARS=3000
LOCAL_MAX_TOKENS=300
VAG_KEEP_ALIVE=10m
# LOCAL_USER_PROFILE=東京都○○区に住んでいる
# LOCAL_TIMEZONE=Asia/Tokyo

# 最新情報の検索(任意)
# SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://127.0.0.1:8080
